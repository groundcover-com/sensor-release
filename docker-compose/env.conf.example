API_KEY=<ingestion key>
CONFIG_OVERRIDES_PATH=/config/overrides.yaml
FLORA_EBPFENABLED=false
FLORA_PROMETHEUSSERVER_ENABLED=false
FLORA_CONTAINERREPOSITORY_TRACKEDCONTAINERTYPE=docker
FLORA_SYSTEMINFO_HOSTMOUNTPATH=/host
GOMAXPROCS=1
GOMEMLIMIT=768MiB
# Through an HTTP proxy: keep the ingestion host out of NO_PROXY.
# HTTPS_PROXY=http://<proxy-host>:<proxy-port>
